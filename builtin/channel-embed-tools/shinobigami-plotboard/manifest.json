{
  "name": "忍神谋位工具",
  "description": "忍神谋位频道嵌入工具",
  "entry": "index.html",
  "defaultWidth": 800,
  "defaultHeight": 400,
  "defaultCollapsed": false,
  "defaultFloating": false,
  "allowPopout": true,
  "mediaOptions": { "allowAudio": false, "allowVideo": false },
